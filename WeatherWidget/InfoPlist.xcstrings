    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow us to fetch your location to provide you your citi's weather."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permítenos acceder a tu ubicación para mostrarte el clima de tu ciudad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisez-nous à accéder à votre position pour vous indiquer la météo de votre ville."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "તમારા શહેરનું હવામાન બતાવવા માટે અમને તમારું સ્થાન ઍક્સેસ કરવાની મંજૂરી આપો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "अपने शहर का मौसम दिखाने के लिए हमें अपना स्थान एक्सेस करने की अनुमति दें।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਤੁਹਾਡੇ ਸ਼ਹਿਰ ਦਾ ਮੌਸਮ ਦਿਖਾਉਣ ਲਈ ਸਾਨੂੰ ਤੁਹਾਡੀ ਟਿਕਾਣਾ ਵਰਤਣ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ।"
          }
        }
      }
    },
    "NSLocationAlwaysUsageDescription" : {
      "comment" : "Privacy - Location Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow us to locate you"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permítenos localizarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisez-nous à vous localiser"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "અમને તમારું સ્થાન જાણવા દો"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "हमें आपका स्थान जानने दें"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ਸਾਨੂੰ ਤੁਹਾਡੀ ਟਿਕਾਣਾ ਜਾਣਨ ਦਿਓ"
          }
        }
      }
    },
