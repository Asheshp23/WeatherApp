        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* ਸਿਰਫ਼ ਅੱਖਰ (a-z) ਹੀ ਮਨਜ਼ੂਰ ਹਨ।"
          }
