            "value" : "* Solo se permiten letras (a-z)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* Seules les lettres (a-z) sont autorisées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* ફક્ત અક્ષરો (a-z) જ માન્ય છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* केवल अक्षर (a-z) मान्य हैं।"
