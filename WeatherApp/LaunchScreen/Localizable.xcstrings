      }
    },
    "* only letters (a-z), numbers (0-9) and periods(.) are allowed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* Solo se permiten letras (a-z), números (0-9) y puntos (.)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* Seules les lettres (a-z), les chiffres (0-9) et les points (.) sont autorisés."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* ફક્ત અક્ષરો (a-z), અંકો (0-9) અને પૂર્ણવિરામ (.) જ માન્ય છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* केवल अक्षर (a-z), अंक (0-9) और बिंदु (.) मान्य हैं।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "* ਸਿਰਫ਼ ਅੱਖਰ (a-z), ਅੰਕ (0-9) ਅਤੇ ਬਿੰਦੀਆਂ (.) ਹੀ ਮਨਜ਼ੂਰ ਹਨ।"
