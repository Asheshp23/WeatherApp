    "Pull to refresh on the main screen and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desliza hacia abajo para actualizar en la pantalla principal e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tirez vers le bas pour actualiser l'écran principal, puis réessayez."
